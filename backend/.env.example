# Copy to .env in this directory and fill in. Never commit .env or real API keys.
# Product info: https://grelve.com/

# Required: DeepSeek API for Grelve planning and build agents.
DEEPSEEK_API_KEY=

# Shipyard LLM (OpenAI-compatible). Defaults match DeepSeek V4 Pro, non-thinking mode.
# SHIPYARD_LLM_BASE_URL=https://api.deepseek.com/v1
# SHIPYARD_LLM_MODEL=deepseek-v4-pro
# SHIPYARD_LLM_THINKING=disabled
# Legacy aliases (optional): DEEPSEEK_BASE_URL, DEEPSEEK_MODEL

# Optional: OpenAI-compatible provider instead of DeepSeek.
# OPENAI_API_KEY=
# SHIPYARD_LLM_API_KEY=

# Estimated cost display on /preview (USD per 1M tokens).
# SHIPYARD_LLM_INPUT_COST_PER_1M=0.435
# SHIPYARD_LLM_OUTPUT_COST_PER_1M=0.87

# Optional: max LLM turns per agent before stopping (default 500).
# SHIPYARD_MAX_AGENT_TURNS=500

# Optional: API display name (default Grelve API).
# PROJECT_NAME=Grelve API

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
