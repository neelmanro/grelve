# Copy to .env and fill in. Never commit real keys.
GROQ_API_KEY=

# Optional: Groq speech translation model (default whisper-large-v3).
# GROQ_TRANSLATION_MODEL=whisper-large-v3

# Required: DeepSeek API for Shipyard planning and repo agents (OpenAI-compatible chat completions).
# Use a non-reasoning model id (e.g. deepseek-chat). For DeepSeek's reasoning model use deepseek-reasoner instead.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Optional: max LLM turns per agent before stopping (default 500).
# SHIPYARD_MAX_AGENT_TURNS=500

# Optional: Docker code-server editor for generated Shipyard workspaces.
# SHIPYARD_CODE_SERVER_IMAGE=jinoe-shipyard-code-server:latest
# SHIPYARD_EDITOR_BIND_HOST=127.0.0.1
# SHIPYARD_EDITOR_PUBLIC_HOST=127.0.0.1
# SHIPYARD_EDITOR_PORT_BASE=43000

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
